# Copy to .env.local and fill in. Never commit real values.
# Only the REQUIRED section is needed to run the app. Everything below it is optional.

# ---------- REQUIRED ----------

# Public URL of this site (canonical URL, sitemap, emails, verification links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB connection string (an Atlas cluster or replica set is needed for transactions)
MONGODB_URI=

# Secrets. Generate with:
#   AUTH_SECRET     openssl rand -base64 48
#   ENCRYPTION_KEY  openssl rand -base64 32   (must decode to 32 bytes)
#   CRON_SECRET     openssl rand -hex 24
AUTH_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=

# Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# First admin account, used only by `npm run seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- OPTIONAL (uncomment to use) ----------

# Sender name in emails (default: Meridian)
# BREVO_SENDER_NAME=Meridian

# Web push notifications. Generate with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Brevo bounce and complaint webhook. URL: https://YOUR-DOMAIN/api/webhooks/brevo?token=<this value>
# BREVO_WEBHOOK_SECRET=

# Only if the investor app lives on a different domain than the site
# NEXT_PUBLIC_APP_URL=

# Online payments (NOWPayments). Leave unset to keep the manual deposit review flow.
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# NOWPAYMENTS_SANDBOX=true
# Automatic withdrawals (payout login, and the authenticator secret that confirms payouts)
# NOWPAYMENTS_EMAIL=
# NOWPAYMENTS_PASSWORD=
# NOWPAYMENTS_2FA_SECRET=
# Safety limits for automatic withdrawals (also editable in Admin > Settings)
# AUTO_WITHDRAW_MAX_USD=500
# AUTO_WITHDRAW_DAILY_USD=2000
# AUTO_WITHDRAW_NEW_ADDRESS_MAX_USD=100
